# Copy file ini ke .env.local dan isi dengan value asli
# JANGAN COMMIT file .env.local ke git

# Connection string dari Neon. Ambil yang bertanda "Pooled connection".
# Bentuknya: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

SESSION_SECRET=generate-random-32-chars-or-more-abcdef1234567890
AUTH_USERNAME=your-username
AUTH_PIN=123456
